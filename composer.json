{
  "name": "m09xd/medqueue",
  "description": "MedQueue PHP backend and frontend integration",
  "type": "project",
  "require": {
    "php": ">=8.2"
  },
  "autoload": {
    "psr-4": {
      "MedQueue\\": "Backend/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MedQueue\\Tests\\": "Backend/tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.4"
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml"
  },
  "config": {
    "sort-packages": true
  }
}
