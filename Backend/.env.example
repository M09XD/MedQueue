APP_ENV=local
APP_DEBUG=1
APP_URL=http://localhost
APP_NAME=MedQueue

# Session cookie: Secure=1 only when APP_URL is https
SESSION_SECURE=0
SESSION_NAME=mq_sess
SESSION_SAMESITE=Lax

# Optional extra browser origin (e.g. Live Server). Empty = same-origin only.
CORS_ORIGIN=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=medqueue
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
